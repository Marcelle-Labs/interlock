# Both forms deliberately: the trailing slash matches a directory, the bare name
# also matches a symlink. Pointing node_modules at another checkout is a normal
# thing to do in a worktree, and with only the slash form that symlink is not
# ignored — it gets committed, and CI then fails on ENOTDIR at install.
node_modules
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Generated fixture repositories and scratch space for the HAC-330 experiment.
# The committed evidence packet is the record; the fixtures are rebuilt
# deterministically by `npm run hac330` and must never be nested git histories
# inside this one.
experiments/**/.work/

# Never commit environment values. Record variable NAMES in the bootstrap
# receipt instead; DISCLOSURE.md and check-provenance.mjs both depend on this.
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
gha-creds-*.json

.DS_Store
*.log
.vscode/
!.vscode/extensions.json
.idea/

# Playwright MCP drops console logs, DOM snapshots and screenshots beside the
# working directory when the cockpit or storyboard is inspected in a browser.
# Inspection output is not evidence and must never reach a commit.
.playwright-mcp/

# HAC-335 Veo hero: generated candidates are large and only the selected one is
# promoted into the package. The ledger records every round either way, so a
# discarded candidate is still a fact even when its bytes are not committed.
media/hac-335/veo-hero/candidates/*.mp4
