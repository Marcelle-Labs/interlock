{
  "name": "@marcelle-labs/interlock",
  "version": "0.0.0",
  "private": true,
  "description": "Interlock — composition engine and reference application for the WorkspaceJSON Interlock contest submission",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:packet": "node experiments/hac-330/bin/verify-packet.mjs",
    "check:packet:s2": "node experiments/hac-326/bin/verify-packet.mjs",
    "check": "pnpm run check:provenance && pnpm run check:packet && pnpm run check:packet:s2",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "hac330": "node experiments/hac-330/bin/run-experiment.mjs",
    "hac326": "pnpm run build && node experiments/hac-326/bin/run-experiment.mjs"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
