        "selector": "JSXOpeningElement[name.name='GateStinger'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|device|play|annotate|control|reducedMotion|onComplete|className|key|ref|className|style|children)$/]",
        "message": "<GateStinger> doesn't accept that prop. Declared props: size, variant, device, play, annotate, control, reducedMotion, onComplete, className."
      },
      {
