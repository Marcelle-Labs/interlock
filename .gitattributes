# Video and audio masters are large binary artifacts that no diff can read and
# that a checkout must never try to merge. They live in Git LFS so the object
# database stays clonable; the working tree still holds real bytes, so every
# digest gate verifies exactly what it verified before.
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text
*.mp3  filter=lfs diff=lfs merge=lfs -text
