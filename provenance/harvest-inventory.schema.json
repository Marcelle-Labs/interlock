{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Marcelle-Labs/interlock/provenance/harvest-inventory.schema.json",
  "title": "Interlock harvest inventory",
  "description": "Shape of the HAC-321 harvest ledger's machine-checked inventory. The shape is stated here; scripts/check-harvest.mjs enforces it plus the invariants a schema cannot express — that every path under a coverage root is claimed exactly once, and that the markdown summary's counts match.",
  "type": "object",
  "additionalProperties": false,
  "required": ["inventoryVersion", "owningIssue", "ledger", "dispositions", "coverageRoots", "capabilities"],
  "properties": {
    "$schema": { "type": "string" },
    "inventoryVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owningIssue": { "type": "string", "pattern": "^[A-Z]{2,5}-\\d+$" },
    "ledger": { "type": "string", "minLength": 1 },
    "notes": { "type": "array", "items": { "type": "string" } },

    "dispositions": {
      "description": "The legal disposition vocabulary, from HAC-321. Declared here rather than hardcoded so a change to the vocabulary is a visible diff.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/disposition" }
    },

    "coverageRoots": {
      "description": "Every place a capability can live. 'children' treats each top-level entry as one capability unit; 'recursive' requires every file to be claimed.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["children", "recursive"] }
        }
      }
    },

    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capability" }
    },

    "findings": {
      "description": "Sprint output that is not code. A finding has no paths, so it cannot participate in coverage — and cannot be used to claim a directory nobody classified.",
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },

    "notInInventory": {
      "description": "Deliberate absences, recorded so an absence is never mistaken for an oversight. Each states why it cannot be a row and what would change that.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "entersInventoryWhen"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "reason": { "type": "string", "minLength": 20 },
          "entersInventoryWhen": { "type": "string", "minLength": 1 }
        }
      }
    }
  },

  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },

    "disposition": {
      "enum": [
        "HARVEST_INTEGRATIONS",
        "HARVEST_STANDARD_RESEARCH",
        "HARVEST_STUDIO",
        "HARVEST_SWARM",
        "KEEP_INTERLOCK",
        "DELETE_HACKATHON_ONLY"
      ]
    },

    "ownerIssue": {
      "description": "A durable owner that was filed or amended — a Linear identifier, or the Fibery open-question form.",
      "type": "string",
      "pattern": "^(?:[A-Z]{2,5}-\\d+|Fibery OQ-\\d+)$"
    },

    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "paths", "disposition", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "disposition": { "$ref": "#/$defs/disposition" },
        "ownerIssue": { "$ref": "#/$defs/ownerIssue" },
        "ownerAmendedAt": { "type": "string", "format": "date" },
        "rationale": { "type": "string", "minLength": 20 },
        "supersededParts": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "pattern": "^HARVEST_" } }, "required": ["disposition"] },
          "then": { "required": ["ownerIssue", "ownerAmendedAt"] },
          "else": { "not": { "required": ["ownerIssue"] } }
        }
      ]
    },

    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source", "disposition", "rationale"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 20 },
        "source": { "type": "string", "minLength": 1 },
        "disposition": { "$ref": "#/$defs/disposition" },
        "ownerIssue": { "$ref": "#/$defs/ownerIssue" },
        "durableHome": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 20 }
      }
    }
  }
}
