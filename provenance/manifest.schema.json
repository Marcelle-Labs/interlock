{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Marcelle-Labs/interlock/provenance/manifest.schema.json",
  "title": "Interlock provenance manifest",
  "description": "Machine-readable record of every nontrivial dependency and work product in the Interlock submission. This file documents the shape; scripts/check-provenance.mjs is what enforces it in CI.",
  "type": "object",
  "required": [
    "manifestVersion",
    "product",
    "submissionRepository",
    "owningOrganization",
    "contestPeriodStart",
    "bootstrapIssue",
    "dependencies",
    "submissionLocalMachinery",
    "newlyCreatedForContest"
  ],
  "additionalProperties": true,
  "properties": {
    "manifestVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "product": { "const": "Interlock" },
    "submissionRepository": { "const": "Marcelle-Labs/interlock" },
    "owningOrganization": { "type": "string", "minLength": 1 },
    "contestPeriodStart": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "bootstrapIssue": { "type": "string", "minLength": 1 },
    "bootstrapRecordedAt": { "type": "string", "format": "date-time" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "submissionLocalMachinery": {
      "type": "array",
      "items": { "$ref": "#/$defs/localMachinery" }
    },
    "newlyCreatedForContest": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/newWork" }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "remote",
        "owningOrganization",
        "origin",
        "pinnedSha",
        "disposition",
        "consumption",
        "purpose",
        "devpostDisclosure",
        "harvestDisposition"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "remote": { "type": "string", "pattern": "^https://" },
        "owningOrganization": { "type": "string", "minLength": 1 },
        "origin": { "enum": ["PRE_EXISTING", "CREATED_DURING_CONTEST"] },
        "pinnedSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pinnedRef": { "type": "string" },
        "pinnedVersions": { "type": "object" },
        "disposition": {
          "enum": [
            "WRITABLE",
            "READ_ONLY_PINNED",
            "READ_INSPECT",
            "EXECUTE_READ_ONLY"
          ]
        },
        "consumption": {
          "enum": ["CONSUMED", "COPIED"],
          "description": "CONSUMED means linked, installed, or executed in place. COPIED means source was vendored into this repository and requires explicit disclosure review."
        },
        "purpose": { "type": "string", "minLength": 20 },
        "devpostDisclosure": { "type": "string", "minLength": 40 },
        "harvestDisposition": {
          "enum": [
            "NOT_APPLICABLE",
            "HARVEST_OR_DELETE_AFTER_SUBMISSION",
            "DELETE_AFTER_SUBMISSION"
          ]
        },
        "boundaryNotes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "localMachinery": {
      "type": "object",
      "required": [
        "id",
        "purpose",
        "status",
        "notPartOfReleasedStandard",
        "disclosureLanguage",
        "harvestDisposition"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "purpose": { "type": "string", "minLength": 20 },
        "status": { "enum": ["PLANNED", "IN_PROGRESS", "BUILT", "REMOVED"] },
        "notPartOfReleasedStandard": { "const": true },
        "disclosureLanguage": { "type": "string", "minLength": 40 },
        "harvestDisposition": {
          "enum": [
            "HARVEST_OR_DELETE_AFTER_SUBMISSION",
            "DELETE_AFTER_SUBMISSION"
          ]
        },
        "harvestTarget": { "type": "string" }
      }
    },
    "newWork": {
      "type": "object",
      "required": [
        "id",
        "repository",
        "remote",
        "owningOrganization",
        "origin",
        "initialSha",
        "disposition",
        "purpose"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "remote": { "type": "string", "pattern": "^https://" },
        "owningOrganization": { "type": "string", "minLength": 1 },
        "origin": { "const": "CREATED_DURING_CONTEST" },
        "initialSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "disposition": { "const": "WRITABLE" },
        "purpose": { "type": "string", "minLength": 20 },
        "mustNotAbsorb": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
